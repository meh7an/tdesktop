using "ui/basic.style";

twidgetCaptionStyle: TextStyle(defaultTextStyle) {
	font: font(12px);
}
twidgetTitleStyle: TextStyle(defaultTextStyle) {
	font: font(16px semibold);
}
twidgetDisplayStyle: TextStyle(defaultTextStyle) {
	font: font(32px);
}
twidgetMonoStyle: TextStyle(defaultTextStyle) {
	font: font(13px);
}

twidgetLabWidth: 560px;
twidgetLabControlPadding: margins(24px, 6px, 24px, 6px);
twidgetLabSliderPadding: margins(24px, 4px, 24px, 12px);
twidgetLabNamePadding: margins(24px, 12px, 24px, 6px);
twidgetLabSendPadding: margins(24px, 0px, 24px, 4px);
twidgetLabBubbleSkip: 8px;
